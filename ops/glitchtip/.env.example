# Copy to .env next to this file. .env is gitignored — never commit the real one.

# Django secret for the GlitchTip instance. Generate with:
#   openssl rand -hex 32
GLITCHTIP_SECRET_KEY=

# Must match the URL you actually open in the browser. With the default
# SSH-tunnel setup (ssh -L 8001:127.0.0.1:8001 root@autoskipper.uk) leave as is.
GLITCHTIP_DOMAIN=http://localhost:8001
