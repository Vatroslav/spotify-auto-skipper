# Spotify API credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm credentials (from https://www.last.fm/api/account/create)
LASTFM_USERNAME=
LASTFM_API_KEY=
# API secret is required for write methods (track.love) used by Loved Sync
LASTFM_API_SECRET=

# Secret key for session signing (min 16 chars, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Base URL — your server's public HTTPS URL (required for Spotify OAuth callback)
# For local dev with ngrok: https://abc123.ngrok-free.app
# For production: https://skipper.yourdomain.com
BASE_URL=https://your-server-url.com

# Restrict login to a single Spotify account (strongly recommended).
# Set to your Spotify user ID so only you can log in.
# If left empty, login is DISABLED by default (fail-closed) so a stranger who
# finds the URL can't log in and overwrite your tokens with their own account.
ALLOWED_SPOTIFY_USER=

# Escape hatch: set to "true" to allow ANY Spotify account to log in while
# ALLOWED_SPOTIFY_USER is empty. Insecure — only for throwaway/local testing.
ALLOW_ANY_SPOTIFY_USER=

# Error tracking (Sentry) — leave empty to disable reporting entirely.
# Create a project at https://sentry.io (pick the FastAPI platform) and copy its
# DSN here. Looks like: https://<key>@o123456.ingest.sentry.io/1234567
# It is a credential: keep it in .env only, never in the repo.
SENTRY_DSN=

# Optional label for the events ("production" when unset).
SENTRY_ENVIRONMENT=
