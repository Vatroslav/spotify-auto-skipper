# Spotify API credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm credentials (from https://www.last.fm/api/account/create)
LASTFM_USERNAME=
LASTFM_API_KEY=

# Secret key for session signing (min 16 chars, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Base URL — your server's public HTTPS URL (required for Spotify OAuth callback)
# For local dev with ngrok: https://abc123.ngrok-free.app
# For production: https://skipper.yourdomain.com
BASE_URL=https://your-server-url.com
