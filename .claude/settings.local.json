{
  "permissions": {
    "allow": [
      "Bash(ssh root@autoskipper.uk:*)",
      "mcp__Claude_Preview__preview_start",
      "Skill(deploy)",
      "Skill(deploy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-version-bump.sh",
            "statusMessage": "Checking version bump..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-delete-transaction.sh",
            "statusMessage": "Checking DELETE safety..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__Claude_(Browser|Preview)__preview_start",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check-local-app-run.py",
            "statusMessage": "Checking local app run..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/format-on-save.sh",
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  }
}
